# 构建产物
/dist/
/bin/
*.exe
*.test
*.out

# 密钥材料 —— 绝不入库
*.pem
*.key
keys/
private/

# 备份产物与审计
*.zip
*.usbk
*.part
audit.log
backups/

# 临时冒烟/联调目录
/_smoke/
/tmp/
*.log

# 编辑器
.idea/
.vscode/
*.swp

# 运行期数据
/config.json
*.local.json
/logs/
/audit.jsonl

# R2 凭据 —— 里面是明文/可解密的 access key，误提交等于泄露 token
# （安装器会在目标目录写出 client.json；开发时也常落到仓库根或脚本目录）
client.json
.tmp-client.json
client.bin
.machine.key

# Go 工具链本地缓存（若把 GOPATH 放在仓库内）
/.gopath/

# 误落在仓库根的裸二进制
# （交叉编译时写了 GOOS=linux go build ./cmd/usbunseal-r2 但忘了 -o，
#  产物不带 .exe 后缀，上面的 *.exe 规则拦不住）
/usbbackup-r2
/usbkeygen-r2
/usbsetup-r2
/usbunseal-r2
/usbcomp-r2
